<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      AppCompat 主题(去掉 Material Components 依赖)。
      注意:colorPrimaryVariant / colorOnPrimary / colorSecondary / colorOnSecondary 都是
      Material 专有属性,AppCompat 下不存在,这里换成等价属性、视觉保持一致:
      colorPrimaryVariant -> colorPrimaryDark(深色态)、colorSecondary -> colorAccent(强调色)。
    -->
    <style name="Theme.RtChat" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#2C6EB5</item>
        <item name="colorPrimaryDark">#1A5B9E</item>
        <item name="colorAccent">#1F7A3D</item>
        <item name="android:windowBackground">#F2F5F9</item>
        <item name="android:statusBarColor">#1A5B9E</item>
    </style>
</resources>
